<Window x:ClassModifier="internal"
        x:Class="Callout.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:Callout"
        xmlns:vm="clr-namespace:Callout.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Style="{StaticResource AppWindow}"
        Title="{x:Static app:AppInfo.Name}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20,18,20,20">

        <!-- Header -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Source="{StaticResource LogoImage}" Width="40" Height="40" />

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleText}" Text="{x:Static app:AppInfo.Name}" />
                <TextBlock Style="{StaticResource CaptionText}" Text="{x:Static app:AppInfo.Tagline}" />
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Pill}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Starting">
                                        <Setter Property="Fill" Value="{StaticResource PendingBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Listening">
                                        <Setter Property="Fill" Value="{StaticResource LiveBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Off" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Starting">
                                        <Setter Property="Text" Value="Starting" />
                                        <Setter Property="Foreground" Value="{StaticResource PendingBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Listening">
                                        <Setter Property="Text" Value="Live" />
                                        <Setter Property="Foreground" Value="{StaticResource LiveBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Audio -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="AUDIO" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Voice chat source" />
                <DockPanel IsEnabled="{Binding CanEditSettings}">
                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Style="{StaticResource IconButton}"
                            ToolTip="Refresh devices" Command="{Binding RefreshDevicesCommand}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
                    </Button>
                    <ComboBox MinHeight="34" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                              DisplayMemberPath="DisplayName" />
                </DockPanel>

                <ProgressBar Margin="0,10,0,0" Height="4" Maximum="1" Value="{Binding InputLevel, Mode=OneWay}"
                             ToolTip="Input level: if this stays empty, Callout hears nothing from this source"
                             Visibility="{Binding IsListening, Converter={StaticResource VisibleWhenTrue}}" />

                <StackPanel Visibility="{Binding OffersPlayback, Converter={StaticResource VisibleWhenTrue}}">
                    <CheckBox Margin="0,16,0,8" Style="{StaticResource ToggleSwitch}" Content="Hear voice chat on"
                              IsChecked="{Binding PlaybackEnabled}" IsEnabled="{Binding CanEditSettings}" />
                    <ComboBox MinHeight="34" ItemsSource="{Binding PlaybackDevices}" SelectedItem="{Binding SelectedPlaybackDevice}"
                              DisplayMemberPath="DisplayName" IsEnabled="{Binding CanPickPlaybackDevice}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Translation -->
        <Border Margin="0,12,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="TRANSLATION" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Teammates speak" />
                <ComboBox MinHeight="34" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberPath="Label" IsEnabled="{Binding CanEditSettings}" />
                <TextBlock Margin="2,6,0,0" Style="{StaticResource CaptionText}"
                           Text="Auto-detect works out each line on its own, so mixed-language lobbies just work. Pin a language if short callouts get misread." />

                <CheckBox Margin="0,14,0,16" Style="{StaticResource ToggleSwitch}" Content="Hide lines already in English"
                          IsChecked="{Binding HideEnglishSpeech}" IsEnabled="{Binding CanEditSettings}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Quality" />
                <ListBox Style="{StaticResource SegmentedControl}" ItemsSource="{Binding ModelOptions}"
                         SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Label" IsEnabled="{Binding CanEditSettings}" />
                <TextBlock Margin="2,6,0,0" Style="{StaticResource CaptionText}" Text="{Binding SelectedModel.Detail}" />

                <TextBlock Margin="0,16,0,6" Style="{StaticResource FieldLabel}" Text="Show translations in" />
                <ListBox Style="{StaticResource SegmentedControl}" ItemsSource="{Binding DisplayModeOptions}"
                         SelectedItem="{Binding SelectedDisplayMode}" DisplayMemberPath="Label" />

                <CheckBox Margin="0,14,0,0" Style="{StaticResource ToggleSwitch}" Content="Lock overlay (clicks go to the game)"
                          IsChecked="{Binding Overlay.IsLocked}"
                          Visibility="{Binding IsOverlayMode, Converter={StaticResource VisibleWhenTrue}}" />

                <Button Margin="2,12,0,0" HorizontalAlignment="Left" Style="{StaticResource LinkButton}"
                        Command="{Binding OpenChatCommand}"
                        Visibility="{Binding IsChatMode, Converter={StaticResource VisibleWhenTrue}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE8BD;" />
                        <TextBlock Margin="6,0,0,0" Text="Open chat window" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Action -->
        <Button Margin="0,18,0,0" Command="{Binding ToggleListeningCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Listening">
                            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                            <Setter Property="Text" Value="&#xE768;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Listening">
                                    <Setter Property="Text" Value="&#xE71A;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Margin="10,0,0,0" Text="{Binding ToggleLabel}" />
            </StackPanel>
        </Button>

        <TextBlock Margin="2,12,0,0" Style="{StaticResource CaptionText}" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="{Binding Status}" />
        <TextBlock Margin="2,4,0,0" Style="{StaticResource CaptionText}" Text="{Binding ActivitySummary}"
                   Visibility="{Binding IsListening, Converter={StaticResource VisibleWhenTrue}}" />

        <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource SurfaceBrush}">
            <TextBlock Style="{StaticResource CaptionText}">
                <Run Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Text="Tip:" />
                <Run Text="start your game, press refresh, and pick it under “App: …” to hear only that game. For the best accuracy, install VB-Cable and set the game's voice chat output to “CABLE Input”, so gunfire never reaches the translator. For the overlay, use windowed or borderless fullscreen." />
            </TextBlock>
        </Border>
    </StackPanel>
</Window>
