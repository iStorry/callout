<Window x:ClassModifier="internal"
        x:Class="Callout.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:Callout"
        xmlns:vm="clr-namespace:Callout.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OverlayViewModel}"
        Title="{x:Static app:AppInfo.Name}"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Left="{Binding Left, Mode=TwoWay}"
        Top="{Binding Top, Mode=TwoWay}"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <!-- No effects or animations: transparent windows render on the CPU, so this stays static between lines. -->
    <Border Padding="6" CornerRadius="10" BorderThickness="1.5">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLocked}" Value="False">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        <Setter Property="Background" Value="#400E1014" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel>
            <Border Margin="0,0,0,4" Padding="10,8" CornerRadius="6" Background="{StaticResource OverlayLineBrush}" HorizontalAlignment="Left">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocked}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="13">
                    <Run FontWeight="SemiBold" Text="Drag to position." />
                    <Run Foreground="{StaticResource TextSecondaryBrush}" Text="Lock the overlay in the app when done." />
                </TextBlock>
            </Border>

            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TranscriptLine}">
                        <Border Margin="0,2" CornerRadius="6" Background="{StaticResource OverlayLineBrush}" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="6,0,0,6" Background="{StaticResource BrandGradientBrush}" />
                                <Border Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Style="{StaticResource LanguageTag}">
                                    <TextBlock Text="{Binding LanguageTag}" />
                                </Border>
                                <TextBlock Grid.Column="2" Margin="0,6,12,7" Text="{Binding Text}" TextWrapping="Wrap"
                                           Foreground="White" FontSize="17" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
